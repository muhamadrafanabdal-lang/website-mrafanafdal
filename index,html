<script>

/* =====================================================
   PPT FILE
===================================================== */

const pptFile =
document.getElementById("pptFile");

const pptStatus =
document.getElementById("pptStatus");

pptFile.addEventListener("change",function(){

    const file=this.files[0];

    if(!file){
        pptStatus.innerHTML=
        "Belum ada file yang dipilih.";
        return;
    }

    pptStatus.innerHTML=
    "✅ File PPT dipilih: <b>"+
    file.name+
    "</b>";

});


/* =====================================================
   SLIDE PPT
===================================================== */

let slides=[];
let currentSlide=0;

const slideInput=
document.getElementById("slideInput");

const slideImage=
document.getElementById("slideImage");

const slidePlaceholder=
document.getElementById("slidePlaceholder");

const slideCounter=
document.getElementById("slideCounter");


slideInput.addEventListener(
"change",
function(){

    slides=[];

    const files=
    Array.from(this.files);

    files.sort(
        (a,b)=>
        a.name.localeCompare(
            b.name,
            undefined,
            {numeric:true}
        )
    );

    files.forEach(file=>{

        const url=
        URL.createObjectURL(file);

        slides.push(url);

    });

    currentSlide=0;

    showSlide();

});


function showSlide(){

    if(slides.length===0){

        slideImage.style.display=
        "none";

        slidePlaceholder.style.display=
        "block";

        slideCounter.innerText=
        "0 / 0";

        return;
    }


    slidePlaceholder.style.display=
    "none";

    slideImage.style.display=
    "block";

    slideImage.src=
    slides[currentSlide];

    slideCounter.innerText=
    (currentSlide+1)+
    " / "+
    slides.length;

}


function nextSlide(){

    if(slides.length===0)
        return;

    currentSlide++;

    if(currentSlide>=slides.length){
        currentSlide=0;
    }

    showSlide();

}


function previousSlide(){

    if(slides.length===0)
        return;

    currentSlide--;

    if(currentSlide<0){
        currentSlide=slides.length-1;
    }

    showSlide();

}


/* =====================================================
   KEYBOARD SLIDE
===================================================== */

document.addEventListener(
"keydown",
function(event){

    if(event.key==="ArrowRight"){
        nextSlide();
    }

    if(event.key==="ArrowLeft"){
        previousSlide();
    }

});


/* =====================================================
   VIDEO 1
===================================================== */

const videoInput1=
document.getElementById("videoInput1");

const video1=
document.getElementById("video1");


videoInput1.addEventListener(
"change",
function(){

    const file=this.files[0];

    if(!file)
        return;

    video1.src=
    URL.createObjectURL(file);

    video1.style.display=
    "block";

});


/* =====================================================
   VIDEO 2
===================================================== */

const videoInput2=
document.getElementById("videoInput2");

const video2=
document.getElementById("video2");


videoInput2.addEventListener(
"change",
function(){

    const file=this.files[0];

    if(!file)
        return;

    video2.src=
    URL.createObjectURL(file);

    video2.style.display=
    "block";

});


/* =====================================================
   SCROLL REVEAL
===================================================== */

const revealElements=
document.querySelectorAll(".reveal");


const observer=
new IntersectionObserver(
(entries)=>{

    entries.forEach(entry=>{

        if(entry.isIntersecting){

            entry.target.classList.add("show");

        }

    });

},
{
    threshold:.08
}
);


revealElements.forEach(
element=>{
    observer.observe(element);
});


</script>

